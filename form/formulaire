<!-- =====================================================
     AUTHENTIFICATION
===================================================== -->

<div
    id="authModal"
    class="fixed inset-0 z-[100] flex items-center justify-center bg-black/60 p-4"
>
    <div
        class="w-full max-w-md bg-white rounded-3xl shadow-2xl p-6 sm:p-8"
    >

        <div class="text-center mb-7">

            <div
                class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-sky-100"
            >
                <i class="bi bi-person-circle text-3xl text-sky-600"></i>
            </div>

            <h2
                id="authTitle"
                class="text-2xl font-black text-slate-800"
            >
                Créer votre compte
            </h2>

            <p
                id="authDescription"
                class="mt-2 text-sm text-slate-500"
            >
                Créez votre compte pour accéder à CiteActive.
            </p>

        </div>


        <!-- ================= INSCRIPTION ================= -->

        <form id="registerForm">

            <div class="mb-4">

                <label
                    for="registerName"
                    class="block text-sm font-semibold mb-2"
                >
                    Nom complet
                </label>

                <input
                    id="registerName"
                    type="text"
                    required
                    class="w-full border border-slate-200 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-sky-500"
                    placeholder="Jean Dupont"
                >

            </div>


            <div class="mb-4">

                <label
                    for="registerPhone"
                    class="block text-sm font-semibold mb-2"
                >
                    Téléphone
                </label>

                <input
                    id="registerPhone"
                    type="tel"
                    required
                    class="w-full border border-slate-200 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-sky-500"
                    placeholder="034 12 345 67"
                >

            </div>


            <div class="mb-4">

                <label
                    for="registerEmail"
                    class="block text-sm font-semibold mb-2"
                >
                    Email
                </label>

                <input
                    id="registerEmail"
                    type="email"
                    required
                    class="w-full border border-slate-200 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-sky-500"
                    placeholder="jean@gmail.com"
                >

            </div>


            <div class="mb-6">

                <label
                    for="registerPassword"
                    class="block text-sm font-semibold mb-2"
                >
                    Mot de passe
                </label>

                <input
                    id="registerPassword"
                    type="password"
                    required
                    minlength="6"
                    class="w-full border border-slate-200 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-sky-500"
                    placeholder="••••••••"
                >

            </div>


            <button
                type="submit"
                class="w-full bg-sky-600 hover:bg-sky-700 text-white py-3.5 rounded-xl font-bold transition"
            >
                Créer mon compte
            </button>

        </form>


        <!-- ================= CONNEXION ================= -->

        <form id="loginForm" class="hidden">

            <div class="mb-4">

                <label
                    for="loginEmail"
                    class="block text-sm font-semibold mb-2"
                >
                    Email
                </label>

                <input
                    id="loginEmail"
                    type="email"
                    required
                    class="w-full border border-slate-200 rounded-xl px-4 py-3"
                    placeholder="jean@gmail.com"
                >

            </div>


            <div class="mb-6">

                <label
                    for="loginPassword"
                    class="block text-sm font-semibold mb-2"
                >
                    Mot de passe
                </label>

                <input
                    id="loginPassword"
                    type="password"
                    required
                    class="w-full border border-slate-200 rounded-xl px-4 py-3"
                    placeholder="••••••••"
                >

            </div>


            <button
                type="submit"
                class="w-full bg-sky-600 hover:bg-sky-700 text-white py-3.5 rounded-xl font-bold transition"
            >
                Se connecter
            </button>

        </form>


        <button
            id="switchAuth"
            type="button"
            class="w-full mt-5 text-sm text-sky-600 hover:underline"
        >
            J'ai déjà un compte
        </button>

    </div>
</div>